# Machine-specific configuration (generated by setup/configure_environment.sh)
/config/fraudlens.env

# Raw / generated data
/data/raw/*
!/data/raw/.gitkeep
/data/processed/
*.csv
!/test/sample.csv
*.parquet
*.orc

# Generated models and predictions
/models/
/artifacts/
/predictions/
/spark/results/spark_fraud_*predictions/

# Logs (keep the recorded Hive output and the labelled baseline logs)
/logs/
*.log
!/hive/fraud_analysis_output.log
!/docs/**/*.log

# Local runtime state
derby.log
metastore_db/
spark-warehouse/
hadoop_data/
*.pid
*.out
*.tmp

# Dashboard
/.venv-ui/
/ui/data/*
!/ui/data/.gitkeep

# Python
__pycache__/
*.py[cod]

# Local backups
*.bak
*.backup
*.backup_*
*.before_*

# Downloaded archives and software unpacked inside the repo
*.zip
*.tgz
*.tar.gz
/hadoop/
/pig-*/
/apache-hive-*/
/spark-*-bin-*/
